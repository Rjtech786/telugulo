# Copy to .env.local (dev) or .env.production (EC2) and fill in.

# ─── Supabase (dedicated "telugulo" project) ───
NEXT_PUBLIC_SUPABASE_URL=https://ofusghtmlbhikrohtskm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Server-only — bypasses RLS. Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ─── App secrets ───
# 32-byte base64 key for encrypting API keys at rest:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Secret the daily cron sends (Authorization: Bearer <this>):
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# ─── Site ───
# Dev: http://localhost:3000   Prod: https://telugulo.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Analytics (optional) ───
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
